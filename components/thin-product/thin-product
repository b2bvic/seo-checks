"""thin-product — Detect thin product pages on e-commerce sites.

Fetches pages from a sitemap, counts unique content words (excluding
boilerplate), flags pages under a word threshold. Thin product pages
get filtered by Google and hurt site-wide quality signals.

🌐 Victor Valentine Romo · victorvalentineromo.com · scalewithsearch.com
"""

import sys
import xml.etree.ElementTree as ET

import click
import requests
from bs4 import BeautifulSoup

UA = "Mozilla/5.0 (compatible; thin-product/1.0)"
NS = {"sm": "http://www.sitemaps.org/schemas/sitemap/0.9"}


def fetch(url):
    resp = requests.get(url, timeout=20, headers={"User-Agent": UA})
    resp.raise_for_status()
    return resp.text


def get_sitemap_urls(sitemap_url, limit=200):
    xml = fetch(sitemap_url)
    root = ET.fromstring(xml)
    # Handle sitemap index
    sitemaps = root.findall(".//sm:sitemap/sm:loc", NS)
    if sitemaps:
        urls = []
        for sm in sitemaps[:3]:
            urls += get_sitemap_urls(sm.text.strip(), limit=limit - len(urls))
            if len(urls) >= limit:
                break
        return urls[:limit]
    return [el.text.strip() for el in root.findall(".//sm:url/sm:loc", NS)][:limit]


def count_content_words(html):
    soup = BeautifulSoup(html, "lxml")
    for tag in soup(["script", "style", "nav", "footer", "header", "aside", "noscript"]):
        tag.decompose()
    content = soup.find("main") or soup.find("article") or soup.find("body") or soup
    text = content.get_text(separator=" ", strip=True)
    words = [w for w in text.split() if len(w) > 1]
    return len(words), len(set(w.lower() for w in words))


@click.command()
@click.argument("sitemap_url")
@click.option("--threshold", "-t", default=100, help="Minimum unique words (default: 100)")
@click.option("--limit", "-l", default=100, help="Max pages to check (default: 100)")
@click.option("--json-output", "json_out", is_flag=True)
def main(sitemap_url, threshold, limit, json_out):
    """Detect thin product pages from a sitemap URL."""
    try:
        urls = get_sitemap_urls(sitemap_url, limit=limit)
    except Exception as e:
        click.echo(f"Error fetching sitemap: {e}", err=True)
        sys.exit(1)

    click.echo(f"Checking {len(urls)} pages (threshold: {threshold} unique words)...\n", err=True)

    results = []
    for i, url in enumerate(urls):
        try:
            html = fetch(url)
            total, unique = count_content_words(html)
            results.append({"url": url, "total_words": total, "unique_words": unique, "thin": unique < threshold})
            if (i + 1) % 10 == 0:
                click.echo(f"  {i+1}/{len(urls)} checked", err=True)
        except Exception:
            results.append({"url": url, "total_words": 0, "unique_words": 0, "thin": True, "error": True})

    thin = [r for r in results if r["thin"]]
    ok = [r for r in results if not r["thin"]]

    if json_out:
        import json
        print(json.dumps({"sitemap": sitemap_url, "threshold": threshold, "total": len(results), "thin": len(thin), "pages": results}, indent=2))
        return

    click.echo(f"Thin Product Page Report")
    click.echo(f"Sitemap: {sitemap_url}")
    click.echo(f"Pages checked: {len(results)}")
    click.echo(f"Thin pages (<{threshold} unique words): {len(thin)}")
    click.echo(f"Passing pages: {len(ok)}\n")

    if thin:
        click.echo("THIN PAGES:")
        for r in sorted(thin, key=lambda x: x["unique_words"]):
            flag = " [ERROR]" if r.get("error") else ""
            click.echo(f"  {r['unique_words']:4d} words — {r['url']}{flag}")
    else:
        click.echo("No thin pages found.")

    click.echo(f"\nAvg unique words: {sum(r['unique_words'] for r in results) // max(len(results), 1)}")


if __name__ == "__main__":
    main()
