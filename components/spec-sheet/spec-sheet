"""spec-sheet — Technical spec sheet SEO analyzer for manufacturing websites.

Checks whether product specs are crawlable HTML or trapped in PDFs.
Validates Product schema with technical properties. Manufacturers lose
organic traffic when specs only exist as downloadable PDFs.

🌐 Victor Valentine Romo · victorvalentineromo.com · scalewithsearch.com
"""

import json
import re
import sys
from urllib.parse import urljoin

import click
import requests
from bs4 import BeautifulSoup

UA = "Mozilla/5.0 (compatible; spec-sheet/1.0)"

SPEC_KEYWORDS = ["specification", "spec sheet", "datasheet", "data sheet",
                 "technical data", "product data", "material properties",
                 "dimensions", "tolerance", "capacity", "weight", "voltage",
                 "amperage", "horsepower", "torque", "pressure", "flow rate"]

UNIT_PATTERNS = re.compile(
    r"\b\d+\.?\d*\s*(?:mm|cm|m|in|ft|kg|lb|lbs|oz|psi|bar|kpa|mpa|"
    r"hp|kw|rpm|cfm|gpm|lpm|v|a|w|°[cf]|fahrenheit|celsius|gauge|awg)\b",
    re.IGNORECASE,
)


def fetch(url):
    resp = requests.get(url, timeout=20, headers={"User-Agent": UA})
    resp.raise_for_status()
    return resp.text


def check_pdf_specs(soup, base_url):
    issues = []
    pdf_specs = []

    for link in soup.find_all("a", href=re.compile(r"\.pdf($|\?)", re.IGNORECASE)):
        href = link.get("href", "")
        text = link.get_text(strip=True).lower()
        full_url = urljoin(base_url, href)

        is_spec = any(kw in text for kw in ["spec", "data", "technical", "sheet", "download", "pdf"])
        is_spec = is_spec or any(kw in href.lower() for kw in ["spec", "datasheet", "technical"])

        if is_spec:
            pdf_specs.append({"url": full_url, "text": link.get_text(strip=True)})
            issues.append({
                "type": "SPEC_IN_PDF",
                "severity": "HIGH",
                "detail": f"Spec sheet as PDF: {link.get_text(strip=True)[:60]}",
                "url": full_url,
                "fix": "Create an HTML page with the same spec data. Link to PDF as supplementary download.",
            })

    return issues, pdf_specs


def check_html_specs(soup):
    """Count spec-like content in crawlable HTML."""
    body_text = soup.get_text(separator=" ", strip=True)
    spec_mentions = sum(1 for kw in SPEC_KEYWORDS if kw in body_text.lower())
    unit_matches = UNIT_PATTERNS.findall(body_text)

    # Check for spec tables
    tables = soup.find_all("table")
    spec_tables = 0
    for table in tables:
        table_text = table.get_text(separator=" ", strip=True).lower()
        if any(kw in table_text for kw in SPEC_KEYWORDS) or len(UNIT_PATTERNS.findall(table_text)) >= 3:
            spec_tables += 1

    return {
        "spec_keyword_count": spec_mentions,
        "unit_mentions": len(unit_matches),
        "spec_tables": spec_tables,
        "total_tables": len(tables),
    }


def check_product_schema(soup):
    issues = []
    found_product = False

    for tag in soup.find_all("script", type="application/ld+json"):
        try:
            data = json.loads(tag.string)
            schemas = data if isinstance(data, list) else [data]
            if isinstance(data, dict) and "@graph" in data:
                schemas.extend(data["@graph"])

            for s in schemas:
                if s.get("@type") == "Product":
                    found_product = True
                    # Check for technical properties
                    if not s.get("weight") and not s.get("additionalProperty"):
                        issues.append({
                            "type": "NO_TECHNICAL_PROPS",
                            "severity": "RECOMMENDED",
                            "detail": "Product schema has no weight or additionalProperty for specs",
                            "fix": "Add additionalProperty with PropertyValue entries for each spec dimension.",
                        })
                    if not s.get("material"):
                        issues.append({
                            "type": "NO_MATERIAL",
                            "severity": "RECOMMENDED",
                            "detail": "Product schema missing material property",
                            "fix": "Add material (e.g., 'Stainless Steel 304', 'Aluminum 6061').",
                        })
                    if not s.get("manufacturer"):
                        issues.append({
                            "type": "NO_MANUFACTURER",
                            "severity": "RECOMMENDED",
                            "detail": "Product schema missing manufacturer",
                            "fix": "Add manufacturer with Organization schema.",
                        })
        except (json.JSONDecodeError, TypeError):
            pass

    if not found_product:
        issues.append({
            "type": "NO_PRODUCT_SCHEMA",
            "severity": "HIGH",
            "detail": "No Product schema found",
            "fix": "Add JSON-LD Product schema with additionalProperty for each technical spec.",
        })

    return issues


@click.command()
@click.argument("url")
@click.option("--json-output", "json_out", is_flag=True)
def main(url, json_out):
    """Analyze whether technical specs are SEO-accessible or trapped in PDFs."""
    try:
        html = fetch(url)
    except Exception as e:
        click.echo(f"Error fetching {url}: {e}", err=True)
        sys.exit(1)

    soup = BeautifulSoup(html, "lxml")
    pdf_issues, pdf_specs = check_pdf_specs(soup, url)
    html_stats = check_html_specs(soup)
    schema_issues = check_product_schema(soup)
    all_issues = pdf_issues + schema_issues

    if json_out:
        print(json.dumps({"url": url, "issues": all_issues, "html_specs": html_stats,
                          "pdf_specs": pdf_specs}, indent=2))
        return

    click.echo(f"\nSpec Sheet SEO Audit: {url}\n")
    click.echo(f"  HTML spec content:")
    click.echo(f"    Spec keywords found: {html_stats['spec_keyword_count']}")
    click.echo(f"    Unit measurements: {html_stats['unit_mentions']}")
    click.echo(f"    Spec tables: {html_stats['spec_tables']} of {html_stats['total_tables']} tables")
    click.echo()

    if pdf_specs:
        click.echo(f"  PDF spec sheets: {len(pdf_specs)}")
        for p in pdf_specs:
            click.echo(f"    {p['text'][:50]}: {p['url'][:60]}")
        click.echo()

    if all_issues:
        high = [i for i in all_issues if i["severity"] == "HIGH"]
        rec = [i for i in all_issues if i["severity"] == "RECOMMENDED"]
        if high:
            click.echo(f"  HIGH ({len(high)}):")
            for i in high:
                click.echo(f"    {i['type']}: {i['detail']}")
                click.echo(f"      Fix: {i['fix']}")
        if rec:
            click.echo(f"  RECOMMENDED ({len(rec)}):")
            for i in rec:
                click.echo(f"    {i['type']}: {i['detail']}")
    else:
        click.echo("  No issues found.")

    click.echo()


if __name__ == "__main__":
    main()
