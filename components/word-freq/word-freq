"""word-freq — Keyword density and word frequency analyzer.

Counts single words and 2-3 word phrases, computes density percentages,
and identifies the primary keyword focus of any page or document.

🌐 Victor Valentine Romo · victorvalentineromo.com · scalewithsearch.com
"""

import json
import re
import sys
from collections import Counter

import click
import requests
from bs4 import BeautifulSoup

UA = "Mozilla/5.0 (compatible; word-freq/1.0)"

STOP_WORDS = {
    "the", "a", "an", "and", "or", "but", "in", "on", "at", "to", "for",
    "of", "with", "by", "from", "is", "it", "this", "that", "are", "was",
    "were", "be", "been", "being", "have", "has", "had", "do", "does",
    "did", "will", "would", "could", "should", "may", "might", "can",
    "not", "no", "so", "if", "as", "its", "our", "your", "their", "we",
    "you", "they", "he", "she", "them", "us", "his", "her", "my", "me",
    "i", "all", "each", "every", "both", "few", "more", "most", "other",
    "some", "such", "than", "too", "very", "just", "about", "up", "out",
    "also", "how", "what", "when", "where", "who", "which", "why", "new",
    "one", "two", "get", "like", "make", "into", "over", "after", "before",
}


def fetch(url):
    resp = requests.get(url, timeout=20, headers={"User-Agent": UA})
    resp.raise_for_status()
    return resp.text


def extract_text(html):
    soup = BeautifulSoup(html, "lxml")
    for tag in soup(["script", "style", "nav", "footer", "header", "aside"]):
        tag.decompose()
    content = soup.find("article") or soup.find("main") or soup.find("body") or soup
    return content.get_text(separator=" ", strip=True)


def tokenize(text):
    words = re.findall(r"\b[a-z]{2,}\b", text.lower())
    return [w for w in words if w not in STOP_WORDS]


def ngrams(words, n):
    return [" ".join(words[i:i+n]) for i in range(len(words) - n + 1)]


@click.command()
@click.argument("source")
@click.option("--top", "-n", default=20, help="Top N results (default: 20)")
@click.option("--json-output", "json_out", is_flag=True)
def main(source, top, json_out):
    """Analyze keyword density and word frequency. Accepts URL or file path."""
    if source.startswith("http"):
        try:
            html = fetch(source)
            text = extract_text(html)
        except Exception as e:
            click.echo(f"Error: {e}", err=True)
            sys.exit(1)
    else:
        from pathlib import Path
        p = Path(source)
        if not p.exists():
            click.echo(f"File not found: {source}", err=True)
            sys.exit(1)
        text = p.read_text(encoding="utf-8")

    words = tokenize(text)
    total = len(words)

    singles = Counter(words)
    bigrams = Counter(ngrams(words, 2))
    trigrams = Counter(ngrams(words, 3))

    if json_out:
        print(json.dumps({
            "source": source, "total_words": total,
            "single_words": [{"word": w, "count": c, "density": round(c/total*100, 2)} for w, c in singles.most_common(top)],
            "bigrams": [{"phrase": w, "count": c, "density": round(c/total*100, 2)} for w, c in bigrams.most_common(top)],
            "trigrams": [{"phrase": w, "count": c, "density": round(c/total*100, 2)} for w, c in trigrams.most_common(top)],
        }, indent=2))
        return

    click.echo(f"\nKeyword Density Report: {source}")
    click.echo(f"Total words (excl. stop words): {total}\n")

    click.echo(f"  Single Words (top {top}):")
    for word, count in singles.most_common(top):
        density = count / total * 100
        bar = "█" * min(int(density * 5), 30)
        click.echo(f"    {word:20s} {count:4d} ({density:5.2f}%) {bar}")

    click.echo(f"\n  2-Word Phrases (top {top}):")
    for phrase, count in bigrams.most_common(top):
        if count < 2:
            break
        density = count / total * 100
        click.echo(f"    {phrase:30s} {count:4d} ({density:5.2f}%)")

    click.echo(f"\n  3-Word Phrases (top {top}):")
    for phrase, count in trigrams.most_common(top):
        if count < 2:
            break
        density = count / total * 100
        click.echo(f"    {phrase:40s} {count:4d} ({density:5.2f}%)")

    click.echo()


if __name__ == "__main__":
    main()
