"""local-page-audit — Local-business website and JSON-LD checker.

Checks a public page for LocalBusiness schema fields, address data, contact
details, and a Google Maps embed. It does not access or audit a Google Business
Profile. Field groups below are this tool's lint profile, not Google eligibility
requirements.

🌐 Victor Valentine Romo · victorvalentineromo.com · scalewithsearch.com
"""

import json
import re
import sys

import click
import requests
from bs4 import BeautifulSoup

UA = "Mozilla/5.0 (compatible; local-page-audit/1.0)"

LOCAL_BUSINESS_TYPES = {
    "LocalBusiness": {
        "baseline": ["name", "address", "telephone"],
        "optional": ["openingHours", "openingHoursSpecification", "image", "url",
                     "geo", "priceRange", "description", "review", "aggregateRating",
                     "sameAs", "areaServed", "paymentAccepted", "currenciesAccepted"],
    },
    "Restaurant": {
        "baseline": ["name", "address", "telephone"],
        "optional": ["servesCuisine", "menu", "openingHours", "image", "url",
                     "geo", "priceRange", "acceptsReservations"],
    },
    "MedicalBusiness": {
        "baseline": ["name", "address", "telephone"],
        "optional": ["medicalSpecialty", "openingHours", "image", "url", "geo"],
    },
    "Store": {
        "baseline": ["name", "address", "telephone"],
        "optional": ["openingHours", "image", "url", "geo", "priceRange",
                     "paymentAccepted"],
    },
    "ProfessionalService": {
        "baseline": ["name", "address", "telephone"],
        "optional": ["openingHours", "image", "url", "geo", "priceRange",
                     "areaServed", "knowsAbout"],
    },
}

# Subtypes that inherit from LocalBusiness
SUBTYPES = {
    "AutoRepair", "Bakery", "BarOrPub", "BeautySalon", "CafeOrCoffeeShop",
    "Dentist", "DryCleaningOrLaundry", "Florist", "GasStation", "GroceryStore",
    "HairSalon", "HardwareStore", "HealthClub", "HomeAndConstructionBusiness",
    "InsuranceAgency", "LegalService", "Library", "LodgingBusiness", "Optician",
    "Pharmacy", "RealEstateAgent", "SportsActivityLocation", "TattooParlor",
    "TravelAgency", "VeterinaryCare",
}


def fetch(url):
    resp = requests.get(url, timeout=20, headers={"User-Agent": UA})
    resp.raise_for_status()
    return resp.text


def extract_schemas(html):
    soup = BeautifulSoup(html, "lxml")
    schemas = []
    for tag in soup.find_all("script", type="application/ld+json"):
        try:
            data = json.loads(tag.string)
            if isinstance(data, list):
                schemas.extend(data)
            elif isinstance(data, dict):
                schemas.append(data)
                if "@graph" in data:
                    schemas.extend(data["@graph"])
        except (json.JSONDecodeError, TypeError):
            pass
    return schemas, soup


def find_local_schemas(schemas):
    found = []
    all_types = set(LOCAL_BUSINESS_TYPES.keys()) | SUBTYPES
    for s in schemas:
        stype = s.get("@type", "")
        if isinstance(stype, list):
            for t in stype:
                if t in all_types:
                    found.append((t, s))
        elif stype in all_types:
            found.append((stype, s))
    return found


def audit(stype, data):
    # Use specific spec or fall back to LocalBusiness
    spec = LOCAL_BUSINESS_TYPES.get(stype, LOCAL_BUSINESS_TYPES["LocalBusiness"])
    issues = []
    for f in spec["baseline"]:
        if f not in data or not data[f]:
            issues.append({"field": f, "severity": "BASELINE"})
    for f in spec["optional"]:
        if f not in data or not data[f]:
            issues.append({"field": f, "severity": "OPTIONAL"})

    # Check address completeness
    addr = data.get("address", {})
    if isinstance(addr, dict):
        for f in ["streetAddress", "addressLocality", "addressRegion", "postalCode"]:
            if f not in addr:
                issues.append({"field": f"address.{f}", "severity": "OPTIONAL"})

    # Check geo
    geo = data.get("geo", {})
    if isinstance(geo, dict):
        if not geo.get("latitude") or not geo.get("longitude"):
            issues.append({"field": "geo.latitude/longitude", "severity": "OPTIONAL"})

    return issues


def check_page_signals(soup):
    """Report inspectable local-business elements on the public page."""
    issues = []
    page_text = soup.get_text(separator=" ", strip=True)

    # Check for embedded Google Map
    has_map = bool(soup.find("iframe", src=re.compile(r"google\.com/maps", re.IGNORECASE)))
    if not has_map:
        issues.append({"type": "NO_EMBEDDED_MAP", "severity": "OPTIONAL",
                       "detail": "No Google Maps embed found on the page."})

    # Check for phone number on page
    phone_pattern = re.compile(r"\(?\d{3}\)?[-.\s]?\d{3}[-.\s]?\d{4}")
    if not phone_pattern.search(page_text):
        issues.append({"type": "NO_VISIBLE_PHONE", "severity": "HIGH",
                      "detail": "No phone number visible on page."})

    # Check for physical address text
    addr_pattern = re.compile(r"\d+\s+\w+\s+(st|street|ave|avenue|blvd|boulevard|dr|drive|rd|road|ln|lane)", re.IGNORECASE)
    if not addr_pattern.search(page_text):
        issues.append({"type": "NO_VISIBLE_ADDRESS", "severity": "HIGH",
                      "detail": "No physical address visible on page."})

    return issues


@click.command()
@click.argument("url")
@click.option("--json-output", "json_out", is_flag=True)
def main(url, json_out):
    """Check a public page and its LocalBusiness JSON-LD."""
    try:
        html = fetch(url)
    except Exception as e:
        click.echo(f"Error fetching {url}: {e}", err=True)
        sys.exit(1)

    schemas, soup = extract_schemas(html)
    local = find_local_schemas(schemas)
    page_issues = check_page_signals(soup)

    results = []
    for stype, data in local:
        issues = audit(stype, data)
        spec = LOCAL_BUSINESS_TYPES.get(stype, LOCAL_BUSINESS_TYPES["LocalBusiness"])
        total = len(spec["baseline"]) + len(spec["optional"])
        score = max(0, int((total - len(issues)) / max(total, 1) * 100))
        results.append({"type": stype, "name": data.get("name", "unnamed"), "issues": issues, "score": score})

    if json_out:
        print(json.dumps({"url": url, "schemas": results, "page_issues": page_issues}, indent=2))
        return

    click.echo(f"\nLocal Page Audit: {url}\n")

    if not local:
        all_types = [s.get("@type", "unknown") for s in schemas]
        click.echo("  No LocalBusiness schema found.")
        if all_types:
            click.echo(f"  Found types: {', '.join(str(t) for t in all_types)}")
        click.echo("\n  Add JSON-LD with @type: LocalBusiness (or a subtype) for local SEO.\n")
    else:
        for r in results:
            click.echo(f"  {r['type']}: {r['name']} — Score: {r['score']}/100")
            baseline = [i for i in r["issues"] if i["severity"] == "BASELINE"]
            optional = [i for i in r["issues"] if i["severity"] == "OPTIONAL"]
            if baseline:
                click.echo(f"    BASELINE ABSENT: {', '.join(i['field'] for i in baseline)}")
            if optional:
                click.echo(f"    OPTIONAL ABSENT: {', '.join(i['field'] for i in optional)}")
            if not baseline and not optional:
                click.echo("    All fields in this tool's lint profile are present.")
            click.echo()

    if page_issues:
        click.echo("  Page Signals:")
        for i in page_issues:
            click.echo(f"    {i['type']}: {i['detail']}")
        click.echo()


if __name__ == "__main__":
    main()
