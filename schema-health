"""schema-health — Healthcare schema.org validator.

Validates MedicalBusiness, Physician, MedicalCondition, and MedicalProcedure
schema markup. Checks required fields for healthcare rich results on Google.

🌐 Victor Valentine Romo · victorvalentineromo.com · scalewithsearch.com
"""

import json
import sys

import click
import requests
from bs4 import BeautifulSoup

UA = "Mozilla/5.0 (compatible; schema-health/1.0)"

HEALTHCARE_TYPES = {
    "MedicalBusiness": {
        "required": ["name", "address", "telephone"],
        "recommended": ["openingHours", "geo", "image", "priceRange", "medicalSpecialty", "availableService", "url"],
    },
    "Physician": {
        "required": ["name", "medicalSpecialty"],
        "recommended": ["address", "telephone", "image", "availableService", "hospitalAffiliation", "url"],
    },
    "Dentist": {
        "required": ["name", "address", "telephone"],
        "recommended": ["openingHours", "image", "priceRange", "availableService", "url"],
    },
    "Hospital": {
        "required": ["name", "address", "telephone"],
        "recommended": ["availableService", "medicalSpecialty", "openingHours", "geo", "image"],
    },
    "MedicalCondition": {
        "required": ["name"],
        "recommended": ["associatedAnatomy", "cause", "possibleTreatment", "riskFactor", "signOrSymptom", "status"],
    },
    "MedicalProcedure": {
        "required": ["name"],
        "recommended": ["bodyLocation", "howPerformed", "preparation", "procedureType", "status"],
    },
    "MedicalClinic": {
        "required": ["name", "address", "telephone"],
        "recommended": ["medicalSpecialty", "availableService", "openingHours", "image", "geo"],
    },
}

# Also check LocalBusiness subtypes common in healthcare
ALIAS_TYPES = {"Chiropractic": "MedicalBusiness", "Optician": "MedicalBusiness", "Pharmacy": "MedicalBusiness"}


def fetch(url):
    resp = requests.get(url, timeout=20, headers={"User-Agent": UA})
    resp.raise_for_status()
    return resp.text


def extract_jsonld(html):
    soup = BeautifulSoup(html, "lxml")
    schemas = []
    for tag in soup.find_all("script", type="application/ld+json"):
        try:
            data = json.loads(tag.string)
            if isinstance(data, list):
                schemas.extend(data)
            elif isinstance(data, dict):
                schemas.append(data)
                if "@graph" in data:
                    schemas.extend(data["@graph"])
        except (json.JSONDecodeError, TypeError):
            pass
    return schemas


def find_healthcare_schemas(schemas):
    found = []
    all_types = set(HEALTHCARE_TYPES.keys()) | set(ALIAS_TYPES.keys())
    for s in schemas:
        stype = s.get("@type", "")
        if isinstance(stype, list):
            for t in stype:
                if t in all_types:
                    found.append((t, s))
        elif stype in all_types:
            found.append((stype, s))
    return found


def audit(schema_type, data):
    lookup = ALIAS_TYPES.get(schema_type, schema_type)
    spec = HEALTHCARE_TYPES.get(lookup, {"required": [], "recommended": []})
    issues = []
    for f in spec["required"]:
        if f not in data or not data[f]:
            issues.append({"field": f, "severity": "MISSING"})
    for f in spec["recommended"]:
        if f not in data or not data[f]:
            issues.append({"field": f, "severity": "RECOMMENDED"})
    return issues


@click.command()
@click.argument("url")
@click.option("--json-output", "json_out", is_flag=True)
def main(url, json_out):
    """Validate healthcare schema.org markup for rich results."""
    try:
        html = fetch(url)
    except Exception as e:
        click.echo(f"Error fetching {url}: {e}", err=True)
        sys.exit(1)

    schemas = extract_jsonld(html)
    health_schemas = find_healthcare_schemas(schemas)

    if not health_schemas:
        all_types = [s.get("@type", "unknown") for s in schemas]
        if json_out:
            print(json.dumps({"url": url, "healthcare_schemas": 0, "other_types": all_types}))
        else:
            click.echo(f"No healthcare schema found on {url}")
            if all_types:
                click.echo(f"Found types: {', '.join(str(t) for t in all_types)}")
            click.echo("\nAdd MedicalBusiness, Physician, or MedicalClinic schema for healthcare rich results.")
        sys.exit(1)

    results = []
    for stype, data in health_schemas:
        issues = audit(stype, data)
        missing = sum(1 for i in issues if i["severity"] == "MISSING")
        total_fields = len(HEALTHCARE_TYPES.get(ALIAS_TYPES.get(stype, stype), {}).get("required", [])) + \
                       len(HEALTHCARE_TYPES.get(ALIAS_TYPES.get(stype, stype), {}).get("recommended", []))
        score = max(0, int((total_fields - len(issues)) / max(total_fields, 1) * 100))
        results.append({"type": stype, "name": data.get("name", "unnamed"), "issues": issues, "score": score})

    if json_out:
        print(json.dumps({"url": url, "schemas": results}, indent=2))
        return

    click.echo(f"\nHealthcare Schema Audit: {url}\n")
    for r in results:
        click.echo(f"  {r['type']}: {r['name']} — Score: {r['score']}/100")
        missing = [i for i in r["issues"] if i["severity"] == "MISSING"]
        recommended = [i for i in r["issues"] if i["severity"] == "RECOMMENDED"]
        if missing:
            click.echo(f"    MISSING: {', '.join(i['field'] for i in missing)}")
        if recommended:
            click.echo(f"    RECOMMENDED: {', '.join(i['field'] for i in recommended)}")
        if not missing and not recommended:
            click.echo("    All fields present.")
        click.echo()


if __name__ == "__main__":
    main()
